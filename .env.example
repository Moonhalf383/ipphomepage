# Local development
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/club.sqlite
PORT=3001
# Production: PUBLIC_ORIGIN=https://iplusplus.club, NODE_ENV=production
# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy.
# Registration / transactional mail (Alibaba DirectMail Hangzhou)
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=notice@mail.iplusplus.club
SMTP_PASSWORD=
MAIL_FROM="I++ Club <notice@mail.iplusplus.club>"
# Exact verified email allowed to claim the first president role during registration.
# Remove after initial president registration. All other accounts register as non-members.
INITIAL_PRESIDENT_EMAIL=
# Announcements use a separately approved bulk-mail sender; leave unset until ready.
BULK_SMTP_HOST=
BULK_SMTP_PORT=465
BULK_SMTP_USER=
BULK_SMTP_PASSWORD=
BULK_MAIL_FROM=
